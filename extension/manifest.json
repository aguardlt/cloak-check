{
  "manifest_version": 3,
  "name": "CloakCheck: see a page as Googlebot, Bingbot and AI crawlers",
  "short_name": "CloakCheck",
  "version": "0.1.0",
  "description": "Compares what a page serves to visitors, search engines and AI crawlers, and finds hidden links. Spots SEO cloaking and hacked-site spam.",
  "minimum_chrome_version": "120",
  "action": { "default_popup": "popup.html", "default_title": "CloakCheck" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "declarativeNetRequestWithHostAccess"],
  "optional_host_permissions": ["*://*/*"],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "homepage_url": "https://aguard.lt"
}
